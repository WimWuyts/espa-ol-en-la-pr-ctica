{
  "meta": {
    "project": "Español en la práctica",
    "file": "design tokens — single source of truth",
    "version": "1.0",
    "date": "2026-07-25",
    "note": "Één bron voor álle formaten (Word · PDF · PPTX · HTML) en álle cursussen (C4·C5·C6·C6+). Gouden regel: variatie. Kleur nooit als enige drager."
  },
  "color": {
    "course": {
      "c4": { "name": "Rojo",   "role": "4 Moderne talen",     "primary": "#D64550", "dark": "#A8323B", "tint": "#FBEAEC" },
      "c5": { "name": "Verde",  "role": "5de jaar",            "primary": "#1E9E74", "dark": "#157355", "tint": "#E4F4EE" },
      "c6": { "name": "Azul",   "role": "6de (clean)",         "primary": "#2E77C2", "dark": "#1E5691", "tint": "#E5EFF9" },
      "c6plus": { "name": "Morado", "role": "6de (vervolg)",   "primary": "#7C56A9", "dark": "#5B3E83", "tint": "#EEE8F5" }
    },
    "neutral": {
      "light": { "ink": "#20242E", "paper": "#FCFBF8", "panel": "#FFFFFF", "crema": "#F3EEE4", "line": "#E4E3DE", "lineStrong": "#CFCEC8", "grey": "#6A6E78" },
      "dark":  { "ink": "#ECEBE6", "paper": "#15161A", "panel": "#1C1E24", "crema": "#1E2026", "line": "#2C2E36", "lineStrong": "#3A3D47", "grey": "#9BA0AA" }
    },
    "functional": {
      "_comment": "Laag 2 · taalkleuren. Vast over álle cursussen, enkel binnen grammatica-/woordenschatmarkering. Waarden zijn afgestemd op leesbaarheid op lichte grond; 'dark' = lichtere variant voor donkere grond.",
      "light": { "subject": "#2563EB", "verb": "#D9660A", "object": "#2F9A4A", "time": "#7C4DE0", "place": "#0E9E97", "negation": "#DC2626", "strategy": "#B7860B" },
      "dark":  { "subject": "#6AA0F2", "verb": "#F2933F", "object": "#5FC072", "time": "#AD92F5", "place": "#2FD3C4", "negation": "#F26D6D", "strategy": "#F2C848" },
      "roles": { "subject": "onderwerp/persoon", "verb": "werkwoord", "object": "voorwerp/inhoud", "time": "tijd", "place": "plaats", "negation": "ontkenning/waarschuwing", "strategy": "strategie/aandacht" }
    }
  },
  "type": {
    "direction": "Richting 1 · modern & karaktervol (gekozen 2026-07-25)",
    "fonts": {
      "display": { "family": "Bricolage Grotesque", "weights": [600, 700, 800], "use": "unittitels, lestitels, grote koppen", "license": "SIL OFL 1.1" },
      "body":    { "family": "Inter",               "weights": [400, 500, 600, 700], "use": "lopende tekst, opdrachten, labels", "license": "SIL OFL 1.1" },
      "hand":    { "family": "Caveat",              "weights": [400, 700], "use": "fictieve notities, post-its, leerlingproducten", "license": "SIL OFL 1.1" }
    },
    "fallbacks": {
      "display": "'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif",
      "body": "'Inter', 'Segoe UI', system-ui, sans-serif",
      "hand": "'Caveat', 'Comic Sans MS', cursive"
    },
    "scale": {
      "unitTitle":   { "font": "display", "weight": 700, "print_pt": 30, "screen_px": 40, "leading": 1.08 },
      "lessonTitle": { "font": "display", "weight": 700, "print_pt": 22, "screen_px": 29, "leading": 1.12 },
      "section":     { "font": "display", "weight": 600, "print_pt": 15, "screen_px": 20, "leading": 1.2 },
      "body":        { "font": "body",    "weight": 400, "print_pt": 10.5, "screen_px": 14, "leading": 1.45 },
      "caption":     { "font": "body",    "weight": 400, "print_pt": 8.5, "screen_px": 11, "leading": 1.4 },
      "label":       { "font": "body",    "weight": 700, "print_pt": 8, "screen_px": 11, "leading": 1.2, "smallcaps": true, "tracking": "0.16em", "uppercase": true }
    }
  },
  "shape": {
    "radius": { "card": "14px", "chip": "6px", "pill": "999px" },
    "measure": "65ch",
    "note": "Afgeronde hoeken voor hulp/chat/digitale bronnen; rechte vormen voor grammatica/evaluatie/formele tabellen (zie ontwerpspec §8.7)."
  }
}
